# QueryPilot Environment Configuration

# Primary LLM Provider: "gemini" | "groq" | "openai"
DEFAULT_LLM_PROVIDER=gemini

# Provider API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Agent Model Configuration (can be configured per agent)
SCHEMA_AGENT_MODEL=gemini-2.5-flash
SQL_WRITER_MODEL=gemini-2.5-flash
EXPLAINER_MODEL=gemini-2.5-flash

# Temperatures (SQL Writer strictly 0.0 - 0.1)
SCHEMA_AGENT_TEMPERATURE=0.0
SQL_WRITER_TEMPERATURE=0.0
EXPLAINER_TEMPERATURE=0.2

# Database & MCP Configuration
DATABASE_PATH=data/sample.db
MCP_SERVER_COMMAND=python app/mcp_server/server.py
QUERY_TIMEOUT_SECONDS=10.0
MAX_ROW_CAP=1000
DEFAULT_QUERY_LIMIT=100

# Graph Execution
MAX_RETRIES=3

# Guardrails & Privacy
ENABLE_MASKING=true
SENSITIVE_COLUMNS=customers.email,customers.phone

# Observability
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
